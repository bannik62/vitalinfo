# Copier vers .env et adapter (le fichier .env reste local / non versionné).

# Base URL des appels API (sans slash final). Vide = chemins relatifs (/api…),
# même origine en prod ; en dev Vite proxy /api → backend (voir vite.config.js).
VITE_API_BASE_URL=

# Hôte Supabase (URL publique du projet, pour storage / URLs générées côté client).
VITE_SUPABASE_URL=https://zuvzpcfrbheqeqbiottv.supabase.co

# Dev uniquement : cible du proxy Vite pour /api (non injecté dans le bundle client).
VITE_DEV_PROXY_TARGET=http://localhost:3002
